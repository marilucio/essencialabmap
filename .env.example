# Copy to .env and fill in. All VITE_* values are embedded in the public bundle:
# never put service-role or other secret keys here.

# Supabase (renal leads) — anon/publishable key only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional overrides (code has sensible defaults)
VITE_WHATSAPP_NUMBER=
VITE_MAP_TRIAL_URL=
VITE_RENAL_LEAD_ENDPOINT=
VITE_RENAL_WHATSAPP_PHONE=
VITE_RENAL_ADMIN_WHATSAPP_PHONE=
VITE_RENAL_WEBINAR_SLUG=
VITE_ESSENCIALAB_IOS_URL=
VITE_ESSENCIALAB_ANDROID_URL=

# Meta Pixel por grupo de rotas (IDs públicos). O vite build falha se faltar algum.
# VITE_META_PIXEL_ID fica em .env.production.
# VITE_META_PIXEL_ID=
# /map, /precos, /renal, /renal/obrigado, /webinar
# VITE_META_PIXEL_ID_MAP=

# ------------------------------------------------------------
# Funil /map/comecar (map-comecar.html, netlify/functions/map-funil-lead.mts)
# ------------------------------------------------------------
# Públicas (vão no bundle):
# ID do projeto do Microsoft Clarity do funil. Sem ele, o Clarity não carrega (o build segue).
# VITE_CLARITY_ID_MAP=
# Opcional: destino do teste. Padrão https://essencialab.app/?src=map_funil
# VITE_MAP_FUNIL_TRIAL_URL=

# Só no servidor (Netlify > Site configuration > Environment variables, escopo Functions).
# NUNCA com prefixo VITE_: não podem ir para o navegador.
# URL do projeto Supabase da landing (o mesmo do /renal), onde roda a migration
# supabase/migrations/20261021120000_map_funil_leads.sql.
# MAPF_SUPABASE_URL=https://your-project.supabase.co
# Service role (JWT antigo) ou secret key (sb_secret_...) desse projeto.
# MAPF_SUPABASE_SERVICE_ROLE_KEY=
# Chave do Resend só com permissão de envio, no domínio essencialab.app.
# RESEND_API_KEY=
# Remetente do e-mail do plano, num domínio verificado no Resend.
# MAPF_EMAIL_FROM=Sistema MAP <noreply@essencialab.app>
# Segredo aleatório para assinar o link de descadastro (ex.: openssl rand -hex 32).
# MAPF_UNSUB_SECRET=
# Opcional: origens extras aceitas pela função, separadas por vírgula
# (essencialab.site e a URL do deploy já entram sozinhas).
# MAPF_ALLOWED_ORIGINS=
# Opcional: destino do botão do e-mail. Padrão https://essencialab.app/?src=map_funil
# MAPF_TRIAL_URL=
