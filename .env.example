# Copy to .env and fill in. All VITE_* values are embedded in the public bundle:
# never put service-role or other secret keys here.

# Supabase (renal leads) — anon/publishable key only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional overrides (code has sensible defaults)
VITE_WHATSAPP_NUMBER=
VITE_MAP_TRIAL_URL=
VITE_RENAL_LEAD_ENDPOINT=
VITE_RENAL_WHATSAPP_PHONE=
VITE_RENAL_ADMIN_WHATSAPP_PHONE=
VITE_RENAL_WEBINAR_SLUG=
VITE_ESSENCIALAB_IOS_URL=
VITE_ESSENCIALAB_ANDROID_URL=
